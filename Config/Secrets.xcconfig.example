// Copy to Config/Secrets.xcconfig and fill in. That file is gitignored:
// the token must never reach the repository.
//
// The value is the same token the backends accept, one entry from the
// comma-separated BETA_TOKENS on the server. Ask whoever runs the backends
// for the current one; rotating it means shipping a new build, which is why
// the server side accepts several at once.
BETA_API_TOKEN =

// Signing team for a TestFlight build. Leave this out for on-device debug
// builds: Config/App.xcconfig already defaults to the free personal team.
// Set it to the shared paid account's Team ID to sign for distribution.
// DEVELOPMENT_TEAM = XXXXXXXXXX
