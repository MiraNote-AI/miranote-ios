      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiraNote uses the camera to add photos to your memory pages."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiraNote 使用相机为你的回忆页面添加照片。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Permission prompt; English must match project.yml's Info.plist value.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiraNote uses the microphone to turn your voice into notes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiraNote 使用麦克风把你的声音变成笔记。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Permission prompt; English must match project.yml's Info.plist value.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiraNote saves your exported memory pages to your photo library."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiraNote 会把你导出的回忆页面存到照片图库。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Permission prompt; English must match project.yml's Info.plist value.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiraNote shows your recent photos so you can add them to your memory pages. If you turn on photo memories, it also picks moments to remind you of, and sends some of those photos to an AI service to write the reminder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiraNote 会显示你最近的照片，方便你添加到回忆页面。如果你打开了照片回忆，还会从中挑出值得回忆的时刻提醒你，并把其中部分照片发送给 AI 服务来生成提醒。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
